{
  "compilerOptions": {
    "target": "es2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "jest"]
  },
  "include": [
    "hardhat.config.cts",
    "src/**/*",
    "test/**/*.ts",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "hardhat.config.cts",
    "scripts",
    "test/midl-integration.ts"
  ]
}
