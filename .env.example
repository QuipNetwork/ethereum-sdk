# ============================================
# Quip Network Ethereum SDK - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Values must be unquoted. Never commit .env.
#
# PRIVATE_KEY MUST include the 0x prefix. Forge deploy scripts read it with
# vm.envUint, which rejects unprefixed hex.

# ============================================
# Wallet / broadcast key
# ============================================
# Operations EOA. Pays gas for every forge broadcast. For deploy-all / vet-impl
# it must also be the WalletFactory owner.
PRIVATE_KEY=0xyour_64_character_hex_private_key

# Optional: only needed for scripts/addNetwork.ts (not forge deploys)
DEPLOYER_PRIVATE_KEY=

# ============================================
# Forge deploy (make deploy-*)
# ============================================
# Deployer contract address (CREATE3 factory), NOT the EOA.
# Canonical: 0xA1A3990Ea898123e4B107D0A2f614232bE428Ef1
DEPLOYER_ADDRESS=

# Initial WalletFactory owner (vetting, fees, UUPS upgrades)
FACTORY_OWNER=

# Max wallet-creation fee in wei (non-zero), e.g. 1000000000000000 = 0.001 ETH
MAX_FEE=

# Initial QuipPaymaster proxy owner (WOTS+ sunset family)
PAYMASTER_OWNER=

# Initial ShrincsPaymaster proxy owner
SHRINCS_PAYMASTER_OWNER=

# bytes32 verifier key-bundle commitment (non-zero; initialize reverts otherwise)
SHRINCS_VERIFIER_COMMITMENT=

# Verifier stateful signature budget (uint32, non-zero)
SHRINCS_VERIFIER_MAX_SIGNATURES=

# Optional. Defaults to the keccak-256 suite (only suite the on-chain library verifies).
# SHRINCS_VERIFIER_HASH_SUITE=

# Existing WalletFactory proxy — required for impl/vet and shrincs-only deploys
FACTORY_ADDRESS=

# Freshly deployed wallet impl address to vet (vet-impl only)
IMPLEMENTATION=

# ============================================
# Contract Verification (Etherscan V2 API)
# ============================================
# Single API key works for all Etherscan V2 supported chains
ETHERSCAN_API_KEY=your_etherscan_api_key

# ============================================
# Network RPC URLs
# ============================================
# Only set the networks you need. Wired to [rpc_endpoints] in foundry.toml.

# Testnets
API_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
API_URL_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
API_URL_OP_SEPOLIA=https://opt-sepolia.g.alchemy.com/v2/YOUR_KEY

# Mainnets
API_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# =============================================================================
# MIDL (Bitcoin Execution Layer)
# =============================================================================
#
# MIDL uses the same DEPLOYER_PRIVATE_KEY and PRIVATE_KEY as Ethereum.
# Since both Ethereum and MIDL use secp256k1, the same private key produces
# the same EVM address on both chains. This enables deterministic cross-chain
# addresses via CREATE2 from the same Deployer contract address.
#
# RPC URL is automatically pulled from @midl/executor (https://evm-rpc.regtest.midl.xyz)
