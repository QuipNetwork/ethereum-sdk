# ============================================
# Quip Network — Environment Variables
# ============================================
# Copy this file to .env and fill in only what the flows you run need.
# The Makefile auto-loads .env (unquoted KEY=VALUE lines) and exports it
# to forge / npx child processes.
#
# NOTE: for the Foundry deploy scripts PRIVATE_KEY MUST include the 0x
# prefix (`vm.envUint` parses it as hex only when 0x-prefixed).

# ============================================
# Network RPC URLs  (foundry.toml [rpc_endpoints] + integration tests)
# ============================================
# Only set the networks you target; aliases resolve lazily.

# Testnets
API_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
API_URL_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
API_URL_OP_SEPOLIA=https://opt-sepolia.g.alchemy.com/v2/YOUR_KEY

# Mainnets
API_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Contract verification — Etherscan v2, one key covers all supported chains.
# Required whenever a deploy target passes --verify (the default).
ETHERSCAN_API_KEY=your_etherscan_api_key

# ============================================
# Live deploys (CreateX-direct, sender-guarded)
# Consumed by: 01_DeployFactory, 02_DeployShrincs,
#              PredictAddresses (operator only), scripts/release.ts
# ============================================

# Broadcast key. 0x-prefixed. For live-contract deploys this MUST be
# DEPLOY_OPERATOR's key (sender-guarded salts revert for any other
# sender), and vetting additionally requires it to be the factory owner.
PRIVATE_KEY=0x_your_64_character_hex_private_key

# ⚠️ Every LIVE canonical address (WalletFactory, ShrincsWallet,
# ShrincsPaymaster) is a function of this address, on every chain,
# forever. Guard the key. Also required by `make predict-addresses`
# (live rows) and `npm run release`.
DEPLOY_OPERATOR=0x...

# WalletFactory initialize() owner — controls vetting, fees, upgrades.
# Set to DEPLOY_OPERATOR for single-pass deploys (vetting is
# owner-gated); hand over afterwards via the two-step handover.
FACTORY_OWNER=0x...

# WalletFactory wallet-creation fee bound in wei (01_DeployFactory
# requires non-zero).
MAX_FEE=100000000000000000

# WalletFactory PROXY address — vet-impl-* / deploy-impl-* targets ONLY.
# The live deploy scripts never read this: 02_DeployShrincs derives the
# canonical address from DEPLOY_OPERATOR and accepts no override.
# FACTORY_ADDRESS=0x...

# ============================================
# ShrincsPaymaster initialize() params
# Consumed by: 02_DeployShrincs
# ============================================

SHRINCS_PAYMASTER_OWNER=0x...

# Verifier-key commitment sealed at initialize(). Generate with
# scripts/gen-shrincs-paymaster-verifier.mjs (see below); MAX_SIGNATURES
# must match the value the commitment was generated with.
SHRINCS_VERIFIER_COMMITMENT=0x...
SHRINCS_VERIFIER_MAX_SIGNATURES=1024
# Optional — defaults to the keccak suite (the only one verified on-chain).
# SHRINCS_VERIFIER_HASH_SUITE=

# --- Commitment generation only (scripts/gen-shrincs-paymaster-verifier.mjs).
# ⚠️ SECRET sponsorship-key material: the paymaster backend re-derives its
# signing key from exactly (secret, vaultId, maxSignatures). Back them up;
# losing them bricks sponsorship for the verifier epoch. Prefer passing
# these inline to the one-shot script over persisting them in .env.
# SHRINCS_OPERATOR_SECRET=0x<32 bytes>
# SHRINCS_VERIFIER_VAULT_ID=0x<32 bytes>

# ============================================
# Sunset WOTS+ family only (deprecated Deployer flow)
# Consumed by: script/deprecated/*
# ============================================

# Bootstrapped Deployer contract (canonical: 0xA1A3990E…). Not used by
# live deploys.
DEPLOYER_ADDRESS=0xA1A3990Ea898123e4B107D0A2f614232bE428Ef1

# QuipPaymaster (WOTS+ era) proxy owner — DeployPaymaster / DeployAllWots.
PAYMASTER_OWNER=0x...

# Wallet impl to whitelist — vet-impl-* targets only.
# IMPLEMENTATION=0x...

# ============================================
# Optional test/tooling extras
# ============================================

# Deprecated-SDK fork smoke test (jest, skipped when unset).
# FORK_RPC_URL=

# scripts/getDeploymentBlock.ts one-off (with DEPLOYER_ADDRESS above).
# CONTRACT_ADDRESS=

# =============================================================================
# MIDL (Bitcoin execution layer) — separate Hardhat deployment lineage
# =============================================================================
# Used only by deploy/midl_regtest/*.cts and the fund/drain/balance
# utility scripts. MIDL reuses PRIVATE_KEY, FACTORY_OWNER, MAX_FEE and
# PAYMASTER_OWNER above, plus:
# DEPLOYER_PRIVATE_KEY=      # MIDL deployer wallet (fund/drain/balance, 00_deploy_deployer)
# FUND_AMOUNT=               # fund-deployer amount (ETH)
