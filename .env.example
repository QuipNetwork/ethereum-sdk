# Quip Network Ethereum SDK - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# PRIVATE KEYS (without 0x prefix)
# =============================================================================

# Main wallet private key for deployments and transactions
PRIVATE_KEY=your_private_key_here

# Deployer wallet private key (optional, for initial contract deployment)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# =============================================================================
# ALCHEMY API KEY
# =============================================================================

# Used for the `account` hardhat task
ALCHEMY_API_KEY=your_alchemy_api_key_here

# =============================================================================
# RPC URLs - TESTNETS
# =============================================================================

API_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/your_key
API_URL_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/your_key
API_URL_OP_SEPOLIA=https://opt-sepolia.g.alchemy.com/v2/your_key

# =============================================================================
# RPC URLs - MAINNETS
# =============================================================================

API_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/your_key
API_URL_BASE=https://base-mainnet.g.alchemy.com/v2/your_key
API_URL_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/your_key
API_URL_BSC=https://bnb-mainnet.g.alchemy.com/v2/your_key
API_URL_AVAX=https://avax-mainnet.g.alchemy.com/v2/your_key
API_URL_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/your_key
API_URL_MANTLE=https://mantle-mainnet.g.alchemy.com/v2/your_key
API_URL_CELO=https://celo-mainnet.g.alchemy.com/v2/your_key
API_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/your_key
API_URL_DEGEN=https://rpc.degen.tips

# =============================================================================
# BLOCK EXPLORER API KEYS - ETHEREUM
# =============================================================================

ETHERSCAN_API_KEY=your_etherscan_api_key
ETHERSCAN_SEPOLIA_API_KEY=your_etherscan_api_key

# =============================================================================
# BLOCK EXPLORER API KEYS - BASE
# =============================================================================

BASE_API_KEY=your_basescan_api_key
BASE_SEPOLIA_API_KEY=your_basescan_api_key

# =============================================================================
# BLOCK EXPLORER API KEYS - OPTIMISM
# =============================================================================

OP_ETHERSCAN_API_KEY=your_optimism_etherscan_api_key
OP_ETHERSCAN_SEPOLIA_API_KEY=your_optimism_etherscan_api_key

# =============================================================================
# BLOCK EXPLORER API KEYS - OTHER CHAINS
# =============================================================================

ETHERSCAN_API_KEY_BSC=your_bscscan_api_key
ETHERSCAN_API_KEY_AVAX=your_snowtrace_api_key
ETHERSCAN_API_KEY_POLYGON=your_polygonscan_api_key
ETHERSCAN_API_KEY_MANTLE=your_mantle_explorer_api_key
ETHERSCAN_API_KEY_CELO=your_celoscan_api_key
ETHERSCAN_API_KEY_ARBITRUM=your_arbiscan_api_key
