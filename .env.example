# ============================================
# Quip Network Ethereum SDK - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Note: PRIVATE_KEY should NOT include the 0x prefix

# ============================================
# Wallet Configuration
# ============================================
PRIVATE_KEY=your_64_character_hex_private_key_without_0x

# Optional: Only needed for addNetwork.ts script
DEPLOYER_PRIVATE_KEY=

# ============================================
# Alchemy API Key (for account task)
# ============================================
ALCHEMY_API_KEY=your_alchemy_api_key

# ============================================
# Contract Verification (Etherscan V2 API)
# ============================================
# Single API key works for all Etherscan V2 supported chains
ETHERSCAN_API_KEY=your_etherscan_api_key

# ============================================
# Network RPC URLs
# ============================================
# Only set the networks you need. Others can be left empty or use placeholders.

# Testnets
API_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
API_URL_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
API_URL_OP_SEPOLIA=https://opt-sepolia.g.alchemy.com/v2/YOUR_KEY

# Mainnets
API_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_BSC=https://bsc-dataseed.binance.org
API_URL_AVAX=https://api.avax.network/ext/bc/C/rpc
API_URL_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_MANTLE=https://rpc.mantle.xyz
API_URL_CELO=https://forno.celo.org
API_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
API_URL_DEGEN=https://rpc.degen.tips

# =============================================================================
# MIDL (Bitcoin Execution Layer)
# =============================================================================
#
# MIDL uses the same DEPLOYER_PRIVATE_KEY and PRIVATE_KEY as Ethereum.
# Since both Ethereum and MIDL use secp256k1, the same private key produces
# the same EVM address on both chains. This enables deterministic cross-chain
# addresses via CREATE2 from the same Deployer contract address.
#
# RPC URL is automatically pulled from @midl/executor (https://evm-rpc.regtest.midl.xyz)
