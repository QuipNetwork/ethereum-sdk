{
  "name": "@quip.network/ethereum-sdk",
  "version": "0.3.0-beta.6",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.json"
  ],
  "exports": {
    "./v1": {
      "import": "./dist/src/v1/index.js",
      "types": "./dist/src/v1/index.d.ts"
    },
    "./v1/addresses": {
      "import": "./dist/src/v1/addresses.js",
      "types": "./dist/src/v1/addresses.d.ts"
    },
    "./v1/abi": {
      "import": "./dist/src/v1/abi/index.js",
      "types": "./dist/src/v1/abi/index.d.ts"
    },
    "./v1/errors": {
      "import": "./dist/src/v1/errors.js",
      "types": "./dist/src/v1/errors.d.ts"
    },
    "./v1/gas": {
      "import": "./dist/src/v1/gas.js",
      "types": "./dist/src/v1/gas.d.ts"
    },
    "./v1/userOpCodec": {
      "import": "./dist/src/v1/userOpCodec.js",
      "types": "./dist/src/v1/userOpCodec.d.ts"
    },
    "./v1/shrincs": {
      "import": "./dist/src/v1/shrincs/index.js",
      "types": "./dist/src/v1/shrincs/index.d.ts"
    },
    "./deprecated/v0": {
      "import": "./dist/src/deprecated/v0/index.js",
      "types": "./dist/src/deprecated/v0/index.d.ts"
    }
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rimraf dist out cache_forge",
    "copy-abi": "node scripts/copy-abi.js",
    "build": "forge build && npm run copy-abi && tsc -p tsconfig.build.json",
    "smoke:fe": "node scripts/fe-smoke.mjs",
    "prepack": "npm run build",
    "format": "prettier --write \"**/*.{ts,js,json,sol}\"",
    "lint": "oxlint --deny-warnings src",
    "lint:fix": "oxlint --fix src",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "typecheck": "tsc --noEmit",
    "test": "forge test",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --testPathIgnorePatterns /node_modules/ integration",
    "test:smoke": "forge build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --testPathPattern integration.smoke",
    "test:all": "forge build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "smoke:tarball": "bash scripts/smoke-tarball.sh",
    "smoke:fork": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --testPathPattern smoke.fork",
    "setup": "forge soldeer install && npm install",
    "release": "forge build && npx tsx scripts/release.ts"
  },
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@midl/connectors": "2.0.11",
    "@midl/core": "2.0.11",
    "@midl/executor": "2.0.11",
    "@midl/hardhat-deploy": "2.0.11",
    "@midl/logger": "2.0.11",
    "@midl/node": "2.0.11",
    "@midl/react": "2.0.11",
    "@types/jest": "^29.5.14",
    "@viem/anvil": "^0.0.10",
    "bitcoinjs-lib": "^7.0.0",
    "copyfiles": "^2.4.1",
    "dotenv": "^16.4.7",
    "ecpair": "^3.0.0",
    "esbuild": "0.27.2",
    "ethers": "^6.0.0",
    "hardhat": "^2.22.19",
    "hardhat-deploy": "^0.14.0",
    "jest": "^29.7.0",
    "oxlint": "1.78.0",
    "prettier": "^2.8.8",
    "prettier-plugin-solidity": "^1.1.3",
    "rimraf": "^5.0.5",
    "solhint": "^6.2.1",
    "ts-jest": "^29.3.2"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/hashes": "^1.7.1",
    "@quip.network/hashsigs": "^0.1.0",
    "@quip.network/hashsigs-wasm": "0.2.1-rc9",
    "@scure/bip39": "^1.6.0",
    "viem": "^2.21.0"
  }
}
